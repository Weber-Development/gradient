{
  "name": "@sweberdev/gradient",
  "version": "0.8.0",
  "description": "Accessible OKLCH color scales from one brand color. Contrast built into the step numbers, dark mode included, export for CSS, Tailwind v3/v4 and design tokens. Zero dependencies.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/gradient/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/gradient.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/gradient/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gradient": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "gradient.config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "color",
    "palette",
    "oklch",
    "color-scale",
    "design-tokens",
    "tailwind",
    "dark-mode",
    "accessibility",
    "wcag",
    "contrast"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
